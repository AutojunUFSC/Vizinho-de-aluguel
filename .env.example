# Exemplo de variáveis de ambiente. Copie para `.env` e preencha.
# NÃO comite o `.env` com valores reais.

# Django
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Banco de dados (use DATABASE_URL OU as variáveis individuais)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# Login Único Gov.BR (OAuth2 + OIDC + PKCE)
# Credenciais fornecidas pela Prefeitura/Gov.BR. Em produção, troque o
# GOVBR_PROVIDER_URL para o host de produção e use as credenciais de produção.
# O REDIRECT_URI e o LOGOUT_REDIRECT_URI precisam ser IDÊNTICOS aos cadastrados
# na credencial Gov.BR — qualquer divergência causa erro de redirect_uri.
# ─────────────────────────────────────────────────────────────────────────────
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=https://vizinhodealuguel.up.railway.app/accounts/govbr/callback/
GOVBR_LOGOUT_REDIRECT_URI=https://vizinhodealuguel.up.railway.app/
GOVBR_PROVIDER_URL=https://sso.staging.acesso.gov.br
GOVBR_SCOPES=openid email profile govbr_confiabilidades govbr_confiabilidades_idtoken
